[Unit]
Description=Zodiac Track Serve - read-only track access for mirrors
Documentation=https://github.com/pureagave/zodiac/blob/main/jetson/DEPLOY.md
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=zodiac
WorkingDirectory=/opt/zodiac/jetson
ExecStart=/usr/bin/python3 -u -m zvision.trackserve --dir /var/lib/zodiac/track
Restart=always
RestartSec=3
# Read-only by construction (GET/HEAD, one directory, no traversal), but say so
# to the kernel as well — this process never needs to write anything.
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadOnlyPaths=/var/lib/zodiac/track
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
