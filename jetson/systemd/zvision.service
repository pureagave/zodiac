[Unit]
Description=Zodiac Vision - edge-box threat broadcaster
Documentation=https://github.com/pureagave/zodiac/blob/main/jetson/DEPLOY.md
# Wait for the vehicle network so multicast/broadcast egress has a route.
After=network-online.target
Wants=network-online.target
# The camera may not be enumerated instantly at boot; let it retry forever
# rather than give up. Startup is cheap.
#
# This key is only valid in [Unit] — systemd ignores it under [Service] with a
# log warning, which silently defeats the retry it was meant to guarantee.
StartLimitIntervalSec=0

[Service]
Type=simple
# Config lives in /etc/default/zvision (see install.sh) so you can switch
# fake<->thermal or tune --hz without editing this unit.
#
# REQUIRED, deliberately — no leading "-". With no config the CLI defaults to
# `--source fake`, so a silently-missing file would put three synthetic
# contacts (one of them a recurring phantom collision) on the driver's HUD all
# night, indistinguishable on the wire from real people. A loud failed start
# is the honest outcome; install.sh always writes the file.
EnvironmentFile=/etc/default/zvision
WorkingDirectory=/opt/zodiac/jetson
ExecStart=/usr/bin/python3 -m zvision $ZVISION_ARGS
# Fail-safe: zero the DMX universe on ANY exit, including crash and SIGKILL,
# which the finally-park in app.py cannot reach. olad owns the frame timing and
# would otherwise keep streaming the last universe at 30 Hz forever -- a
# full-bright beam frozen in the fixture's frame while the vehicle turns. The
# head's own BLnd=blac cannot help: from its side the signal never stopped.
# Leading '-' so a dead olad cannot mask the real reason the service stopped.
#
# --from-args-env reads $ZVISION_ARGS (already exported by EnvironmentFile
# above, to every Exec* including this one) so a UNIVERSE=1 deploy parks
# universe 1, not always 0 @ localhost. --default-dmx none: if ZVISION_ARGS
# doesn't mention --dmx at all, that's this CLI's own default (--dmx none),
# so this service doesn't own any olad universe and the park is skipped
# entirely -- an ordinary `systemctl restart zvision` must not blackout the
# deck-owned universe in the split single-writer layout (see DECK.md §3).
ExecStopPost=-/usr/bin/python3 -m zvision.dmxpark --quiet --from-args-env ZVISION_ARGS --default-dmx none
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
