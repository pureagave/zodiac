<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- Android 12+ requires COARSE alongside FINE (user may grant only COARSE). -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!--
      Playa discovery via the Burning Man API (over Starlink), and the future
      NET GPS source (NMEA over UDP 10110). Both need INTERNET.
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- NET GPS source: hold a MulticastLock so the WiFi driver stops filtering
         the fleet's UDP broadcast NMEA before it reaches the app. -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <!-- NavShareSender ($ZNAV): derives the /24 subnet broadcast target from
         WifiManager.dhcpInfo, the app's first device-to-device transmit path. -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />

    <!-- Bluetooth Classic SPP for NMEA GPS receivers (Phase 4d). -->
    <uses-permission
        android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_ADMIN"
        android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" />

    <application
        android:name=".ZodiacApplication"
        android:allowBackup="true"
        android:icon="@android:drawable/ic_menu_compass"
        android:label="Zodiac Control"
        android:roundIcon="@android:drawable/ic_menu_compass"
        android:supportsRtl="true"
        android:theme="@style/Theme.ZodiacControl">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden"
            android:screenOrientation="fullUser">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Auto-grant on USB GPS dongle attach (Phase 4e) -->
            <intent-filter>
                <action android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED" />
            </intent-filter>
            <meta-data
                android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED"
                android:resource="@xml/usb_gps_device_filter" />
        </activity>
        <!--
          Home-activity alias for KIOSKED tablets only. Disabled by default so a
          normal (non-provisioned) device is never offered as a Home app. The
          device owner enables it and pins it as the persistent preferred Home in
          KioskController.engage(); that is what makes a kiosked tablet RELAUNCH
          the cockpit by itself after a reboot / power loss. Android blocks the
          naive BOOT_COMPLETED -> startActivity path, so being the Home app is the
          only reliable auto-launch. targetActivity is MainActivity, so a Home
          launch lands in the same activity as the app-drawer icon and its
          onResume() re-enters lock task. Renaming this alias breaks auto-launch
          on every already-provisioned tablet — see docs/KIOSK.md, same caveat as
          ZodiacDeviceAdminReceiver.
        -->
        <activity-alias
            android:name=".kiosk.KioskHomeActivity"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:enabled="false">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity-alias>
        <!--
          Device-admin component for kiosk mode. Provisioned once per tablet
          over adb after a factory reset (see docs/KIOSK.md); the app runs
          perfectly well unprovisioned, just unlocked.
        -->
        <receiver
            android:name=".kiosk.ZodiacDeviceAdminReceiver"
            android:permission="android.permission.BIND_DEVICE_ADMIN"
            android:exported="true">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
