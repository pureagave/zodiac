{
 "_comment": [
  "GOLDEN CORPUS for the ZCOVER camera-coverage wire format (RES-P2-1)",
  "\u2014 the shared truth for two hand-written implementations:",
  "  producer  jetson/zvision/coverage_protocol.py   (Python, edge box)",
  "  consumer  app/.../core/vision/CoverageProtocol.kt (Kotlin, tablets)",
  "Both test suites read THIS FILE and fail loudly if it is missing.",
  "GENERATED by jetson/tools/gen_coverage_golden.py \u2014 do NOT hand-edit;",
  "change the format and re-run the tool (see protocol/README.md).",
  "parse_vectors:  frame -> covered arcs [[start,end],...], or",
  "                expect=null when the line is not a ZCOVER frame.",
  "                A bare 'ZCOVER' -> [] means nothing covered = all blind.",
  "format_vectors: covered arcs -> the exact bytes."
 ],
 "header": "ZCOVER",
 "max_arcs": 16,
 "max_abs_start_deg": 180.0,
 "cover_decimals": 1,
 "number_grammar": "-?[0-9]{1,9}(\\.[0-9]{1,6})?",
 "parse_vectors": [
  {
   "name": "bare_header_all_blind",
   "frame": "ZCOVER",
   "expect": []
  },
  {
   "name": "single_forward_arc",
   "frame": "ZCOVER;-64.0:64.0",
   "expect": [
    [
     -64.0,
     64.0
    ]
   ]
  },
  {
   "name": "two_disjoint_arcs",
   "frame": "ZCOVER;-30.0:30.0;100.0:170.0",
   "expect": [
    [
     -30.0,
     30.0
    ],
    [
     100.0,
     170.0
    ]
   ]
  },
  {
   "name": "seam_crossing_arc_end_past_180",
   "frame": "ZCOVER;120.0:200.0",
   "expect": [
    [
     120.0,
     200.0
    ]
   ]
  },
  {
   "name": "whole_ring_covered",
   "frame": "ZCOVER;-180.0:180.0",
   "expect": [
    [
     -180.0,
     180.0
    ]
   ]
  },
  {
   "name": "f32_rounded_values",
   "frame": "ZCOVER;12.34:56.78",
   "expect": [
    [
     12.34000015258789,
     56.779998779296875
    ]
   ]
  },
  {
   "name": "trailing_crlf_is_framing_only",
   "frame": "ZCOVER;-64.0:64.0\r\n",
   "expect": [
    [
     -64.0,
     64.0
    ]
   ]
  },
  {
   "name": "not_a_coverage_line_is_rejected",
   "frame": "ZTHREAT;1:-12.0:0.300:0",
   "expect": null
  },
  {
   "name": "garbage_is_rejected",
   "frame": "HELLO WORLD",
   "expect": null
  },
  {
   "name": "empty_line_is_rejected",
   "frame": "",
   "expect": null
  },
  {
   "name": "malformed_arc_skipped_wellformed_kept",
   "frame": "ZCOVER;xx:yy;10.0:50.0",
   "expect": [
    [
     10.0,
     50.0
    ]
   ]
  },
  {
   "name": "hex_float_start_skipped",
   "frame": "ZCOVER;0x1p3:64.0",
   "expect": []
  },
  {
   "name": "start_out_of_range_skipped",
   "frame": "ZCOVER;200.0:250.0",
   "expect": []
  },
  {
   "name": "reversed_arc_skipped",
   "frame": "ZCOVER;50.0:10.0",
   "expect": []
  },
  {
   "name": "too_wide_arc_skipped",
   "frame": "ZCOVER;-180.0:200.0",
   "expect": []
  },
  {
   "name": "wrong_field_count_skipped",
   "frame": "ZCOVER;10.0:20.0:30.0;40.0:80.0",
   "expect": [
    [
     40.0,
     80.0
    ]
   ]
  }
 ],
 "format_vectors": [
  {
   "name": "empty_is_all_blind",
   "arcs": [],
   "frame": "ZCOVER"
  },
  {
   "name": "single_forward_arc",
   "arcs": [
    [
     -64.0,
     64.0
    ]
   ],
   "frame": "ZCOVER;-64.0:64.0"
  },
  {
   "name": "two_disjoint_arcs",
   "arcs": [
    [
     -30.0,
     30.0
    ],
    [
     100.0,
     170.0
    ]
   ],
   "frame": "ZCOVER;-30.0:30.0;100.0:170.0"
  },
  {
   "name": "seam_crossing_arc",
   "arcs": [
    [
     120.0,
     200.0
    ]
   ],
   "frame": "ZCOVER;120.0:200.0"
  },
  {
   "name": "whole_ring",
   "arcs": [
    [
     -180.0,
     180.0
    ]
   ],
   "frame": "ZCOVER;-180.0:180.0"
  },
  {
   "name": "half_even_rounding",
   "arcs": [
