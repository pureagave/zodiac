<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- A boot start is a background start; API 29+ needs this for GPS to work
         from BootReceiver. API 29 can request it alongside fine location; API
         30+ requires a separate follow-up request (BeaconActivity). -->
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <!-- A 12V brownout or thermal reboot must not leave the fleet blind until a
         human physically picks up the phone (AUDIT-2026-08-09 B3). -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Read DHCP info to compute the subnet broadcast address (dynamic DHCP). -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- Keep broadcasting with the screen off — it's a headless box on the vehicle. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Deep Doze (stationary, screen off, unplugged) ignores app wake locks
         outright — this exemption is the other required half of B4's fix.
         BeaconActivity prompts for it once at provisioning. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- Ambient-sound level for reactive lighting ($ZAUD). Level/beat only — no
         audio is recorded to storage or transmitted, just an RMS number. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <!-- Floor type so the service always has a legal foreground-service type to
         start under, even with zero optional permissions granted (degraded but
         running — see AUDIT-2026-08-09 B5). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <application
        android:allowBackup="true"
        android:icon="@android:drawable/ic_menu_compass"
        android:label="Zodiac Beacon"
        android:supportsRtl="true"
        android:theme="@style/Theme.AppCompat.DayNight.DarkActionBar">

        <activity
            android:name=".BeaconActivity"
            android:exported="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".TelemetryService"
            android:exported="false"
            android:foregroundServiceType="location|microphone|specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="offline vehicle telemetry hub: GPS/sensor NMEA broadcast to fleet tablets" />
        </service>

        <!-- exported=true is safe: BOOT_COMPLETED and MY_PACKAGE_REPLACED are
             both protected broadcasts — only the system can send them. -->
        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
